@namespace BlazorFullCalendar

@*
  Top-level mode switch (Event ⇄ Timeline). The Timeline tab is hidden when no resources are
  supplied because the timeline mode is meaningless without resources.
*@

@if (State.Resources.Count > 0)
{
    <div class="bfc-mode-tabs">
        @foreach (var mode in _modes)
        {
            <button class="bfc-mode-tab @(State.Mode == mode ? "active" : "")"
                    @onclick="() => State.SetMode(mode)">
                @Texts.GetModeLabel(mode)
            </button>
        }
    </div>
}

@code {
    [CascadingParameter] public BlazorFullCalendarState State { get; set; } = default!;
    [CascadingParameter] public BlazorFullCalendarTexts Texts { get; set; } = default!;

    private static readonly BlazorFullCalendarMode[] _modes =
    [
        BlazorFullCalendarMode.Event,
        BlazorFullCalendarMode.Timeline
    ];
}
