@page "/resource-timeline"

<PageTitle>Resource Timeline - Blazor Calendar</PageTitle>

<section class="demo-hero" style="padding-bottom:32px;">
    <div class="demo-hero-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        Resource Timeline
    </div>
    <h1>Schedule Across<br/>Resources, Side&#8209;by&#8209;Side</h1>
    <p>
        Inspired by FullCalendar's
        <a href="https://fullcalendar.io/docs/timeline-view" target="_blank" rel="noopener" style="color:var(--demo-primary);">Resource Timeline view</a>,
        the <strong>Timeline</strong> mode is a top-level layout that sits next to the standard
        <strong>Events</strong> mode. Inside Timeline you keep the day, week, and month views &mdash; but the
        rows are resources (rooms, machines, people) and the columns are time. Day and week views use one-hour columns;
        the month view switches to one-day columns to keep the time axis from running away. The grid scrolls horizontally
        when the time axis exceeds the visible width.
    </p>
</section>

<section class="demo-showcase">
    <div class="demo-showcase-header">
        <div class="demo-showcase-badge" style="background:#eff6ff;color:#3b82f6;border:1px solid #bfdbfe;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            New API
        </div>
        <h2>Resources, the <code>Resource</code> property &amp; Timeline mode</h2>
        <p>
            Pass a list of <code>BlazorFullCalendarResource</code> via the <code>Resources</code> parameter and
            tag each <code>BlazorFullCalendarEvent</code> with a matching <code>Resource</code> id.
            The <strong>Timeline</strong> mode tab appears in the header automatically when at least one resource is supplied;
            inside it the day / week / month sub-views show the resource × time grid.
        </p>
    </div>

    <div class="demo-showcase-grid">
        <div class="demo-showcase-card">
            <div class="demo-showcase-card-header">
                <span style="width:28px;height:28px;border-radius:8px;background:#dbeafe;color:#3b82f6;display:inline-flex;align-items:center;justify-content:center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </span>
                <h3>Resource model</h3>
            </div>
            <div class="demo-showcase-card-body">
                <p>
                    A resource is just an <code>Id</code>, a <code>Title</code>, and an optional <code>Subtitle</code>.
                    Resources are matched against <code>BlazorFullCalendarEvent.Resource</code> by their <code>Id</code>.
                </p>
                <div class="demo-code-block" style="margin:0;">
                    <div class="demo-code-label">Define resources</div>
                    <pre><span class="kw">var</span> rooms = <span class="kw">new</span> <span class="type">List&lt;BlazorFullCalendarResource&gt;</span>
{
    <span class="kw">new</span>() { Id = <span class="str">"room-bay"</span>,    Title = <span class="str">"HQ - Bay Wing"</span>, Subtitle = <span class="str">"Headquarters"</span> },
    <span class="kw">new</span>() { Id = <span class="str">"room-garden"</span>, Title = <span class="str">"The Garden"</span>,    Subtitle = <span class="str">"Headquarters"</span> },
    <span class="kw">new</span>() { Id = <span class="str">"room-war"</span>,    Title = <span class="str">"War Room (B1)"</span>, Subtitle = <span class="str">"Basement"</span> },
};</pre>
                </div>
            </div>
        </div>

        <div class="demo-showcase-card">
            <div class="demo-showcase-card-header">
                <span style="width:28px;height:28px;border-radius:8px;background:#fef3c7;color:#d97706;display:inline-flex;align-items:center;justify-content:center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </span>
                <h3>Tag events &amp; render</h3>
            </div>
            <div class="demo-showcase-card-body">
                <p>
                    Set <code>Resource</code> on each event to the matching resource <code>Id</code>.
                    Events without a resource land in the auto-added <em>Unassigned</em> row.
                    Drag any event between rows to reassign it; this fires <code>OnChange</code> with <code>Source = Drag</code>.
                    Set <code>InitialMode="BlazorFullCalendarMode.Timeline"</code> to land users on the timeline straight away.
                </p>
                <div class="demo-code-block" style="margin:0;">
                    <div class="demo-code-label">Render</div>
                    <pre><span class="tag">&lt;BlazorFullCalendar</span>
    <span class="attr">Events</span>=<span class="str">"events"</span>
    <span class="attr">Resources</span>=<span class="str">"rooms"</span>
    <span class="attr">InitialMode</span>=<span class="str">"BlazorFullCalendarMode.Timeline"</span>
    <span class="attr">OnChange</span>=<span class="str">"HandleChange"</span> <span class="tag">/&gt;</span>

<span class="kw">@@code</span> {
    <span class="kw">var</span> ev = <span class="kw">new</span> <span class="type">BlazorFullCalendarEvent</span>
    {
        Title = <span class="str">"Design Review"</span>,
        StartDate = <span class="type">DateTime</span>.Today.AddHours(<span class="str">10</span>),
        EndDate = <span class="type">DateTime</span>.Today.AddHours(<span class="str">11</span>),
        Resource = <span class="str">"room-bay"</span>,
        Color = <span class="type">BlazorFullCalendarEventColor</span>.Purple
    };
}</pre>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="demo-calendar-section">
    <div class="demo-section-header">
        <h2>Live Resource Timeline</h2>
        <p>The Timeline mode is selected by default below; switch between Day, Week, and Month sub-views in the header. Click any cell to add an event, drag events between rows to reassign them, and drag along the row to reschedule.</p>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:flex-end;margin-bottom:16px;">
        <div style="font-size:12px;color:var(--demo-text-secondary);">
            <strong>@_resources.Count</strong> resources, <strong>@_events.Count</strong> events
        </div>
    </div>

    <div class="demo-calendar-container" style="height:720px;">
        <BlazorFullCalendar HideFilters
                            Events="_events"
                            Options="_options"
                            Resources="_resources"
                            OnChange="HandleChange" 
                            InitialMode="BlazorFullCalendarMode.Timeline" />
    </div>

    <div style="margin-top:16px;padding:12px 16px;border:1px solid var(--demo-border);border-radius:var(--demo-radius);background:var(--demo-surface);">
        <div style="font-size:12px;font-weight:600;color:var(--demo-text-secondary);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em;">Last change</div>
        @if (_lastChange is null)
        {
            <p style="margin:0;font-size:13px;color:var(--demo-text-secondary);">Drag, drop, or click an empty cell to schedule an event - changes will appear here.</p>
        }
        else
        {
            <p style="margin:0;font-size:13px;">
                <strong>@_lastChange.Kind</strong> via @_lastChange.Source - @_lastChange.Event.Title
                @if (!string.IsNullOrWhiteSpace(_lastChange.Event.Resource))
                {
                    <span> (resource: <code>@_lastChange.Event.Resource</code>)</span>
                }
                else
                {
                    <span> (resource: <em>unassigned</em>)</span>
                }
            </p>
        }
    </div>
</section>

<footer class="demo-footer">
    <p>
        Blazor Calendar &mdash; Resource Timeline view inspired by
        <a href="https://fullcalendar.io/docs/timeline-view" target="_blank" rel="noopener">FullCalendar Timeline view</a>
    </p>
</footer>

@code {
    private List<BlazorFullCalendarEvent> _events = DemoResourceData.CreateEvents();
    private readonly List<BlazorFullCalendarResource> _resources = DemoResourceData.CreateResources();

    private readonly BlazorFullCalendarOptions _options = new()
    {
        StartOfDayHour = 8,
        Use24HourFormat = true
    };

    private BlazorFullCalendarChangeEventArgs? _lastChange;

    private Task HandleChange(BlazorFullCalendarChangeEventArgs args)
    {
        if (args.Kind == BlazorFullCalendarChangeKind.Add)
            _events.Add(args.Event);
        else if (args.Kind == BlazorFullCalendarChangeKind.Edit)
        {
            var idx = _events.FindIndex(e => e.Id == args.Event.Id);
            if (idx >= 0) _events[idx] = args.Event;
        }
        else if (args.Kind == BlazorFullCalendarChangeKind.Delete)
            _events.RemoveAll(e => e.Id == args.Event.Id);

        _lastChange = args;
        return Task.CompletedTask;
    }
}
